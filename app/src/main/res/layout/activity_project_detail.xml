<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProjectDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="عنوان پروژه" />

        <TextView
            android:id="@+id/tv_detail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp"
            tools:text="توضیحات کامل پروژه در اینجا قرار می‌گیرد و ممکن است چندین خط باشد." />

        <ProgressBar
            android:id="@+id/pb_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            tools:progress="60" />

        <TextView
            android:id="@+id/tv_progress_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            tools:text="۶,۱۰۰,۰۰۰ از ۷,۵۰۰,۰۰۰ تومان جمع‌آوری شده" />

        <EditText
            android:id="@+id/et_donation_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="مبلغ کمک شما (تومان)"
            android:inputType="number" />

        <Button
            android:id="@+id/btn_go_to_payment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پرداخت"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
